# Copy to .env locally; do not commit the real password.
GSME_POSTGRES_PASSWORD=replace-with-a-strong-local-password
GSME_DATABASE_URL=postgresql://gsme_rag:replace-with-a-strong-local-password@127.0.0.1:5432/gsme_rag
GSME_QDRANT_URL=http://127.0.0.1:6333
GSME_DATA_DIR=./data
GSME_EMBED_DIMENSION=1024
GSME_EMBED_BATCH=16
GSME_WORKER_BATCH=8
GSME_MAX_TOKENS=8192
GSME_HYBRID=false
GSME_PDF_BACKEND=auto
# Optional private source for the real-manual regression tests.
# GSME_TEST_MANUAL_PDF=D:/path/to/MFG-GSME-0002.pdf
# Set BOTH only after the organization approves sending document content to Cohere.
# COHERE_API_KEY=
# GSME_EXTERNAL_CONTENT_APPROVED=yes
# Separate permission: reranking transmits user questions AND approved passages.
# GSME_RERANK_CONTENT_APPROVED=yes
GSME_RERANK_MODEL=rerank-v5.0-pro
GSME_RERANK_TIMEOUT=30
# Conservative query+passage UTF-8 byte guard; evidence is never truncated.
GSME_RERANK_INPUT_BUDGET=8192
# Separate approval for sending retrieved evidence to the answer-generation API.
# GSME_ANSWER_CONTENT_APPROVED=yes
GSME_ANSWER_MODEL=command-a-plus-05-2026
GSME_OLLAMA_MODEL=qwen3:4b
GSME_ANSWER_TIMEOUT=60
GSME_ANSWER_PROVIDER=cohere
# Optional extractive compression: none (default) or paragraph. Never rewrites evidence.
GSME_CONTEXT_COMPRESSION=none
# Existing structural chunking remains the default. semantic uses local Nomic
# ONLY to choose boundaries; its digest is recorded in the ingestion profile.
GSME_CHUNK_STRATEGY=auto
# Optional Google adapters are OFF unless separately approved and configured.
# GEMINI_API_KEY=
# GSME_GEMINI_CONTENT_APPROVED=yes
# GSME_GEMINI_MODEL=your-available-model-id
# GSME_VISION_CONTENT_APPROVED=yes
GSME_LOG_LEVEL=INFO
# Local operator console and CLI review. Use a random token of at least 20 characters.
# Start the console only on your own workstation; it binds to 127.0.0.1:8010.
# GSME_AUTHORIZED_REVIEWERS=alice,bob
# GSME_REVIEW_AUTH_TOKEN=long-random-local-secret
