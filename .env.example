# Copy to .env locally. Never commit real passwords, API keys or operator tokens.
# Keep one entry per setting. Restart chatbot/admin after editing .env.
# Future NEW settings go below COPY NEW SETTINGS FROM HERE, grouped by date/release.
# For existing settings, document the edit there; never append duplicate assignments.

# PostgreSQL, Qdrant and artifact storage
# Both password fields must match the actual database account; URL-encode the URL value.
GSME_POSTGRES_PASSWORD=REPLACE_WITH_DATABASE_PASSWORD
GSME_DATABASE_URL=postgresql://gsme_rag:REPLACE_WITH_URL_ENCODED_DATABASE_PASSWORD@127.0.0.1:5432/gsme_rag
GSME_QDRANT_URL=http://127.0.0.1:6333
GSME_QDRANT_API_KEY=
GSME_DATA_DIR=./data

# Embeddings and indexing
COHERE_API_KEY=
# Enable only after the organization approves external document processing.
# GSME_EXTERNAL_CONTENT_APPROVED=yes
GSME_EMBED_DIMENSION=1024
GSME_EMBED_BATCH=16
GSME_WORKER_BATCH=8
GSME_MAX_TOKENS=8192

# Legacy setting; hosted chatbot explicitly uses hybrid retrieval.
GSME_HYBRID=false

# Parsing and chunking
GSME_PDF_BACKEND=auto
GSME_CHUNK_STRATEGY=auto

# Reranking: transmits questions and approved passages to Cohere.
# Enable only after organizational approval.
# GSME_RERANK_CONTENT_APPROVED=yes
GSME_RERANK_MODEL=rerank-v5.0-pro
GSME_RERANK_TIMEOUT=30
GSME_RERANK_INPUT_BUDGET=8192

# Answer generation
# Enable only after organizational approval for external answer generation.
# GSME_ANSWER_CONTENT_APPROVED=yes
GSME_ANSWER_PROVIDER=cohere
GSME_ANSWER_MODEL=command-a-plus-05-2026
GSME_ANSWER_TIMEOUT=60
GSME_CONTEXT_COMPRESSION=none

# Optional local outage recovery.
# Requires running Ollama, the installed model and the existing search index.
# Does not provide offline document embedding.
GSME_OLLAMA_MODEL=qwen3:4b
GSME_LOCAL_OUTAGE_FALLBACK=yes
GSME_LOCAL_RERANK_CANDIDATES=10

# Optional Gemini integration: currently unused.
GEMINI_API_KEY=
GSME_GEMINI_MODEL=
# GSME_GEMINI_CONTENT_APPROVED=yes
# GSME_VISION_CONTENT_APPROVED=yes

# Local chatbot
GSME_HOSTED_ORIGIN=http://127.0.0.1:8020
GSME_HOSTED_TENANT=local-test
GSME_PUBLIC_FAQ_GUEST_ACCESS=yes

# Temporary browser-owned uploads without company sign-in.
# Clearing cookies loses access; it does not automatically delete files.
GSME_GUEST_UPLOADS_ENABLED=yes
GSME_UPLOAD_GLOBAL_DAY=30

# Request limits
GSME_CHAT_PER_USER_MINUTE=6
GSME_CHAT_GLOBAL_MINUTE=8
GSME_CHAT_GLOBAL_DAY=50

# Leave unset until calibrated on reviewed evaluation questions.
# GSME_MIN_RERANK_SCORE=

# Trust only your actual reverse proxy.
GSME_TRUSTED_PROXY_IPS=127.0.0.1

# Local operator console
# Set a unique random token of at least 20 characters locally, 32 for hosted admin.
GSME_AUTHORIZED_REVIEWERS=HP
GSME_REVIEW_AUTH_TOKEN=

# Keep hosted admin disabled for local operation.
# Hosted deployment requires an HTTPS origin, strong token and persistent services.
GSME_HOSTED_ADMIN_ENABLED=no

# Optional future company sign-in.
# GSME_GOOGLE_CLIENT_ID=your-web-client.apps.googleusercontent.com
# GSME_GOOGLE_WORKSPACE_DOMAINS=your-company.example

# Logging
GSME_LOG_LEVEL=INFO

# ==================== COPY NEW SETTINGS FROM HERE ====================
# Append future NEW settings below in dated/release-labelled blocks.
# Copy only keys absent from .env. EDIT existing keys rather than paste duplicates.
# 2026-11-20: format aligned with the cleaned local configuration; no new keys.
# Real secrets stay in .env; external processing approvals remain opt-in here.
