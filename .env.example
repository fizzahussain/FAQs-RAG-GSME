# Copy to .env locally; do not commit the real password.
GSME_POSTGRES_PASSWORD=replace-with-a-strong-local-password
GSME_DATABASE_URL=postgresql://gsme_rag:replace-with-a-strong-local-password@127.0.0.1:5432/gsme_rag
GSME_QDRANT_URL=http://127.0.0.1:6333
GSME_DATA_DIR=./data
GSME_EMBED_DIMENSION=1024
GSME_EMBED_BATCH=16
GSME_WORKER_BATCH=8
GSME_MAX_TOKENS=8192
GSME_HYBRID=false
# Set BOTH only after the organization approves sending document content to Cohere.
# COHERE_API_KEY=
# GSME_EXTERNAL_CONTENT_APPROVED=yes
# Local operator console and CLI review. Use a random token of at least 20 characters.
# Start the console only on your own workstation; it binds to 127.0.0.1:8010.
# GSME_AUTHORIZED_REVIEWERS=alice,bob
# GSME_REVIEW_AUTH_TOKEN=long-random-local-secret
